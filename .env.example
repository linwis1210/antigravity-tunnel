# Copy to client/.env (or export as environment variables) and fill in.
# Never commit a filled-in .env to git — it is already in .gitignore.

# Cloudflare account ID (dash.cloudflare.com -> Workers & Pages -> Overview, right sidebar)
CF_ACCOUNT_ID=

# D1 database ID (dash.cloudflare.com -> D1 -> your database -> Overview)
CF_D1_ID=

# Cloudflare API token with: Account -> Workers Scripts -> Edit, Account -> D1 -> Edit
# Create at https://dash.cloudflare.com/profile/api-tokens
CF_API_TOKEN=

# Your account's workers.dev subdomain (the part before .workers.dev).
# Find it at dash.cloudflare.com -> Workers & Pages -> Overview.
CF_WORKERS_SUBDOMAIN=

# Worker script name (default: antigravity-tunnel)
CF_WORKER_NAME=antigravity-tunnel

# Local Antigravity-Manager address (tunnel_d1_client only)
TUNNEL_LOCAL=http://127.0.0.1:8045

# D1 poll interval in milliseconds (tunnel_d1_client only)
TUNNEL_POLL_MS=1000

# --- deploy_worker.py only: where to read the three Worker secrets from ---
# Each file must be chmod 600 and contain the secret value on one line.
TUNNEL_KEY_FILE=~/.tunnel-key
PUBLIC_KEY_FILE=~/.public-key
BACKEND_KEY_FILE=~/.antigravity-api-key
